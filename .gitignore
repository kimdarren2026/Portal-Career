# ---------------------------------------------------------------------------
# Portal Karir Kampus — repository ignore rules
#
# The approved Laravel/Vue stack produces local dependencies, build output,
# and runtime state. These rules keep those artifacts and secrets out of Git.
# ---------------------------------------------------------------------------

# --- Secrets: never commit real environment values -------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
service-account*.json

# --- Dependencies ----------------------------------------------------------
node_modules/
vendor/
.pnp/
.pnp.js
__pycache__/
*.py[cod]
.venv/
venv/

# --- Build output ----------------------------------------------------------
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
target/
*.tsbuildinfo
apps/api/bootstrap/ssr/

# --- Caches and tooling ----------------------------------------------------
.cache/
.turbo/
.parcel-cache/
.eslintcache
coverage/
.nyc_output/
.pytest_cache/
.mypy_cache/
apps/api/bootstrap/cache/*.php
!apps/api/bootstrap/cache/.gitignore
apps/api/storage/framework/cache/data/*
!apps/api/storage/framework/cache/data/.gitignore
apps/api/storage/framework/sessions/*
!apps/api/storage/framework/sessions/.gitignore
apps/api/storage/framework/views/*
!apps/api/storage/framework/views/.gitignore
apps/api/storage/logs/*
!apps/api/storage/logs/.gitignore

# --- Local service data ----------------------------------------------------
# Docker named volumes are managed outside the working tree. Ignore any
# bind-mounted local data/runtime directories should they be used later.
infra/docker/.data/
infra/docker/data/
infra/docker/runtime/

# --- Logs ------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS and editor noise ---------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json

# ---------------------------------------------------------------------------
# Deliberately NOT ignored
#
#   archive/packages/*.zip
#     The original Stitch export (~30 MB) is intentionally tracked as the
#     historical backup and pre-reorganization restore point. If the repository
#     is pushed to a host with file-size limits, track it with Git LFS rather
#     than removing it.
#
#   design/stitch/**/screen.png
#     Design reference screenshots. Part of the frozen functional baseline.
# ---------------------------------------------------------------------------
