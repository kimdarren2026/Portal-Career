# =============================================================================
# Portal Karir Kampus — environment variable NAMES and PLACEHOLDERS only.
#
# NEVER commit a real value for any secret: application key, database password,
# Redis password, SMTP credential, or S3 key. Production values come from the
# platform secret manager, injected at runtime (SECURITY_ARCHITECTURE.md §6).
# The repository .gitignore excludes .env and .env.* while allowing .env.example.
# =============================================================================

APP_NAME="Portal Karir Kampus"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# Production/staging MUST set: APP_ENV=production (or staging), APP_DEBUG=false,
# APP_URL=https://<host>. With APP_DEBUG=false an uncaught error renders the
# generic error page — no stack trace, SQL, path, env value or secret.

# Reverse proxy / load balancer (DEPLOYMENT_ARCHITECTURE.md §6). Comma list of
# proxy IPs/CIDRs, or `*` when the app is only ever reached through the proxy.
# Unset = trust nothing (correct for local and direct exposure). Required in
# production for correct scheme, host, secure cookies and client-IP rate keys.
TRUSTED_PROXIES=

# User-facing timezone is applied at the render boundary, never in storage.
# All business timestamps are timestamptz persisted in UTC (DATABASE_SCHEMA.md §4).
APP_DISPLAY_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# -----------------------------------------------------------------------------
# Database — PostgreSQL 16+ (ADR-003)
# SQLite must never be used, including in tests: it shares neither partial unique
# indexes nor CHECK semantics, so a SQLite run would silently skip the guarantees
# that matter most (SCHEMA_VALIDATION_REPORT.md §5).
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=portal_karir
# This is the restricted application runtime role. Schema migrations use a
# separate owner credential supplied only to the deployment migration job; do
# not substitute that owner credential in a web, worker, or scheduler runtime.
DB_USERNAME=portal_karir_app
DB_PASSWORD=
DB_CHARSET=utf8
DB_SCHEMA=public
DB_SSLMODE=prefer

# Separate database for the test suite. Also PostgreSQL.
DB_TEST_DATABASE=portal_karir_test

# -----------------------------------------------------------------------------
# Session — PostgreSQL, NOT Redis (ADR-006)
# A Redis eviction or flush would log out every user simultaneously.
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
# Local only. Production/staging (HTTPS): SESSION_SECURE_COOKIE=true.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

# -----------------------------------------------------------------------------
# Redis — cache, queue, locks, rate limiting (ADR-006)
# Predis is the local PHP client for the approved Redis service. Deployments
# may explicitly choose phpredis when its native extension is available.
# Separate logical databases so a cache flush cannot destroy queued work.
# -----------------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1
REDIS_LOCK_DB=2
REDIS_CACHE_CONNECTION=cache
REDIS_QUEUE_CONNECTION=queue
REDIS_CACHE_LOCK_CONNECTION=lock

CACHE_STORE=redis
CACHE_PREFIX=portal_karir_cache
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

# -----------------------------------------------------------------------------
# Object storage — S3-compatible, PRIVATE by default (ADR-007)
# No candidate document is ever reachable by public URL. Downloads are served
# through an authorized, audited application route — never a durable signed link.
# Local development may use MinIO.
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# -----------------------------------------------------------------------------
# Mail — development catcher only. Never a production relay in local/dev.
# Runtime SMTP configuration is managed by Super Admin and stored encrypted in
# smtp_configurations (ADR-015, INV-035). The encryption key lives OUTSIDE the
# database and is supplied here by name, never as a literal in the repository.
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# The frozen SMTP configuration foundation (smtp-configuration-foundation-v1)
# encrypts smtp_configurations.encrypted_password with Laravel's Crypt, keyed by
# APP_KEY — already deployment-supplied and held outside the database (INV-035).
# A DB restore without the matching APP_KEY leaves the credential undecryptable;
# a Super Admin must then re-enter it (ADR-015 — see the runbook). This
# dedicated-key variable is reserved for a future move to a separate key and is
# currently unused by the runtime.
SMTP_CONFIG_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Inertia SSR — fourth runtime process (ADR-017)
# Same release as the application; restart on every deploy.
# -----------------------------------------------------------------------------
INERTIA_SSR_ENABLED=false
INERTIA_SSR_URL=http://127.0.0.1:13714

# -----------------------------------------------------------------------------
# Logging and observability
# -----------------------------------------------------------------------------
# Production/staging: structured JSON to stdout, collected by the platform
# (DEPLOYMENT_ARCHITECTURE.md §5). Set:
#   LOG_CHANNEL=stderr
#   LOG_STDERR_FORMATTER="Monolog\\Formatter\\JsonFormatter"
#   LOG_LEVEL=info
# Never logged: passwords, tokens, SMTP credentials, API secrets, session ids,
# file contents. Every line carries the correlation id (X-Request-Id).
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_STDERR_FORMATTER=

VITE_APP_NAME="${APP_NAME}"
